# Copy to .env.hosted and replace every `replace-*` value. Never commit that file.
NODE_ENV=production
HOST=0.0.0.0
PORT=80
LOG_LEVEL=info

WBO_HOSTED_MODE=true
AUTH_SECRET_KEY=replace-with-a-permanent-32-byte-base64url-secret
WBO_HOSTED_OPERATOR_EMAILS=operator@example.com

# Use an immutable release/tag/commit mapping for the AGPL source page.
WBO_DEPLOYMENT_VERSION=replace-with-an-immutable-version
WBO_CORRESPONDING_SOURCE_URL=https://github.com/replace-owner/replace-repo/tree/{version}
WBO_CORRESPONDING_SOURCE_BUILD=npm ci && npm test && docker build .

# PostgreSQL runs on the private Compose network. Generate a URL-safe password
# so the same value can be embedded in the connection URL without escaping.
POSTGRES_DB=sukimacanvas
POSTGRES_USER=sukimacanvas
POSTGRES_PASSWORD=replace-with-a-url-safe-postgres-password
WBO_HOSTED_STATE_STORE=postgres
WBO_HOSTED_DATABASE_URL=postgresql://sukimacanvas:replace-with-a-url-safe-postgres-password@postgres:5432/sukimacanvas
WBO_HOSTED_DATABASE_SSL=disable
WBO_HOSTED_DATABASE_MAX_CONNECTIONS=10

# Cloudflare R2: keep the bucket private and issue a bucket-scoped Object Read
# & Write token. Region must be `auto`; endpoint contains the Cloudflare account id.
WBO_HOSTED_OBJECT_STORE=s3
WBO_HOSTED_S3_ENDPOINT=https://replace-account-id.r2.cloudflarestorage.com
WBO_HOSTED_S3_BUCKET=replace-with-private-bucket-name
WBO_HOSTED_S3_REGION=auto
WBO_HOSTED_S3_PREFIX=production
WBO_HOSTED_S3_ACCESS_KEY_ID=replace-with-r2-access-key-id
WBO_HOSTED_S3_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key

# Cloudflare Email Sending over implicit TLS.
WBO_HOSTED_MAIL_TRANSPORT=smtp
WBO_HOSTED_MAIL_FROM=no-reply@example.com
WBO_HOSTED_MAIL_FROM_NAME=SukimaCanvas
WBO_HOSTED_SMTP_HOST=smtp.mx.cloudflare.net
WBO_HOSTED_SMTP_PORT=465
WBO_HOSTED_SMTP_USER=api_token
WBO_HOSTED_SMTP_PASSWORD=replace-with-cloudflare-email-api-token
WBO_HOSTED_SMTP_TLS=true

# This example assumes exactly one reverse proxy terminates HTTPS.
WBO_IP_SOURCE=X-Forwarded-For
WBO_TRUST_PROXY_HOPS=1

# Optional but recommended before opening public registration.
# TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
# TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
